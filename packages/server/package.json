{
  "name": "@cca/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Node.js authoritative jatekszerver",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "check:pickup-effects": "tsx scripts/check-pickup-effects.ts",
    "check:spawn-protection": "tsx scripts/check-spawn-protection.ts",
    "check:rewind": "tsx scripts/check-rewind.ts",
    "check:net": "tsx scripts/smoke-two-clients.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --external:ws --external:@dimforge/rapier3d-compat --outfile=dist/server.js"
  },
  "dependencies": {
    "@cca/shared": "*",
    "@dimforge/rapier3d-compat": "^0.20.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13"
  }
}
