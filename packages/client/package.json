{
  "name": "@cca/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Three.js bongeszo-kliens",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "screenshot": "tsx scripts/screenshot.ts",
    "check:mp": "tsx scripts/check-multiplayer.ts",
    "check:collision": "tsx scripts/check-collision.ts",
    "check:death": "tsx scripts/check-death.ts",
    "check:wheel-damage": "tsx scripts/check-wheel-damage.ts",
    "check:pickup": "tsx scripts/check-pickup.ts",
    "check:match-flow": "tsx scripts/check-match-flow.ts",
    "check:dev": "tsx scripts/check-dev-mode.ts",
    "check:rocket-visual": "tsx scripts/check-rocket-visual.ts",
    "check:timeline": "tsx scripts/check-interp-timeline.ts",
    "check:boost": "tsx scripts/check-boost-tank.ts",
    "check:scoreboard": "tsx scripts/check-scoreboard.ts",
    "check:respawn": "tsx scripts/check-respawn.ts",
    "check:car-colors": "tsx scripts/check-colors.ts",
    "check:mg": "tsx scripts/check-machinegun.ts",
    "check:lobby": "tsx scripts/check-lobby.ts",
    "check:input": "tsx scripts/check-ui-input.ts",
    "check:lag": "tsx scripts/check-multiplayer.ts --lag=200 && tsx scripts/check-collision.ts --lag=200",
    "audio": "tsx scripts/prepare-audio.ts",
    "check:sound": "tsx scripts/check-sound.ts",
    "check:cannon": "tsx scripts/check-cannon.ts",
    "check:map": "tsx scripts/check-map.ts",
    "check:hitbox": "tsx scripts/check-hitbox.ts",
    "check:trimesh": "tsx scripts/check-trimesh.ts",
    "check:freelook-ui": "tsx scripts/check-freelook.ts",
    "check:reset-hold": "tsx scripts/check-reset-hold.ts",
    "kit-meret": "tsx scripts/kit-meret.ts",
    "auto-meret": "tsx scripts/auto-meret.ts",
    "utkozes-meret": "tsx scripts/utkozes-meret.ts"
  },
  "dependencies": {
    "@cca/shared": "*",
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "playwright": "^1.62.1",
    "vite": "^6.0.3"
  }
}
